## The wiki

wiki-start = Start { $title }
wiki-start-page = Start the page for { $title }
wiki-text = Text
wiki-markup-help = Blank lines separate paragraphs. <code>h2. Heading</code>, <code>* list item</code>,
    <code>[b]bold[/b]</code>, <code>[i]italic[/i]</code>, <code>[[tag]]</code> or
    <code>[[tag|text]]</code> for another wiki page, <code>{ "{{" }search{ "}}" }</code> for search
    results, <code>post #123</code>, and plain links.
wiki-other-names-hint = What the tag is called elsewhere, such as its Japanese name or a romanisation, separated by spaces (underscores within a name).

wiki-history-all = <a href="/wiki_page_versions">All wiki changes</a>, with a filter by user.
wiki-other-names-changed = other names changed
wiki-deprecated-tag = deprecated tag
wiki-version = version { $version }, { $date }
wiki-version-by = version { $version }, { $date } by { $user }
wiki-artist-entry = Artist entry
wiki-artist-banned = (banned)
wiki-artist-start = Start an artist entry
wiki-start-this = Start this page
wiki-other-names = Other names:
wiki-alias-of = This tag is an alias of <a href="{ $url }">{ $title }</a>.
wiki-old-version = This is an old version ({ $version }) of the page. <a href="{ $url }">See the current one</a>.
wiki-none = There's no wiki page for { $title } yet.
wiki-none-hint = A wiki page says what a tag means and when to use it, so everyone tags the same way.

wiki-search-placeholder = long_ha, *_hair or an other name
wiki-recent-changes = <a href="/wiki_page_versions">Recent changes</a> to every page.
wiki-table = Wiki index table
wiki-none-found = No wiki pages found.
